/* ============================================================
   智能门禁访客管理系统 - light theme
   ============================================================ */

QWidget {
    font-family: "Microsoft YaHei", "SimHei", sans-serif;
    font-size: 13px;
    color: #1F2937;
    background-color: #F3F6FA;
}

QMainWindow,
QScrollArea,
QSplitter::handle,
QDialog {
    background-color: #F3F6FA;
}

QScrollArea {
    border: none;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QGroupBox {
    border: 1px solid #D7E0EA;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    color: #334155;
    background-color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
}

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

QPushButton#btn_alarm {
    background-color: #DC2626;
}

QPushButton#btn_alarm:hover {
    background-color: #B91C1C;
}

QPushButton#btn_alarm:pressed {
    background-color: #991B1B;
}

QPushButton#btn_unlock,
QPushButton#btn_reset {
    background-color: #16A34A;
}

QPushButton#btn_unlock:hover,
QPushButton#btn_reset:hover {
    background-color: #15803D;
}

QPushButton#btn_unlock:pressed,
QPushButton#btn_reset:pressed {
    background-color: #166534;
}

QPushButton#btn_doorbell {
    background-color: #0284C7;
}

QPushButton#btn_doorbell:hover {
    background-color: #0369A1;
}

QPushButton#btn_doorbell:pressed {
    background-color: #075985;
}

QPushButton#btn_night {
    background-color: #7C3AED;
}

QPushButton#btn_night:hover {
    background-color: #6D28D9;
}

QPushButton#btn_night:pressed {
    background-color: #5B21B6;
}

QPushButton#btn_voice {
    background-color: #EA580C;
}

QPushButton#btn_voice:hover {
    background-color: #C2410C;
}

QPushButton#btn_voice:pressed {
    background-color: #9A3412;
}

QLabel {
    color: #334155;
    background: transparent;
}

QLabel#title_label {
    font-size: 20px;
    font-weight: bold;
    color: #0F172A;
    padding: 8px 0;
}

QLabel#status_label {
    font-size: 15px;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 4px;
}

QFrame#status_card,
QFrame#env_card,
QFrame#metric_card,
QFrame#chart_frame,
QFrame#sensor_ext_card {
    background-color: #FFFFFF;
    border: 1px solid #D7E0EA;
    border-radius: 6px;
}

QFrame#status_card:hover,
QFrame#env_card:hover,
QFrame#metric_card:hover {
    border-color: #2563EB;
}

QFrame#sensor_ext_card[alert="true"] {
    border-color: #DC2626;
    background-color: #FEF2F2;
}

QLCDNumber {
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    background-color: #F8FAFC;
    color: #16A34A;
    min-height: 48px;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #D7E0EA;
    border-radius: 6px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #EAF1FB;
    color: #334155;
    font-weight: bold;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #2563EB;
}

QLabel#metric_title {
    color: #64748B;
    font-size: 11px;
}

QLabel#metric_value {
    font-size: 15px;
    font-weight: bold;
}

QPlainTextEdit#diagnostic_log,
QTextEdit,
QPlainTextEdit {
    background-color: #F8FAFC;
    color: #1F2937;
    border: 1px solid #D7E0EA;
    border-radius: 6px;
    padding: 8px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}

QScrollBar:vertical {
    background: #EEF2F7;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #EEF2F7;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QStatusBar {
    background-color: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #D7E0EA;
}

QFrame#separator {
    background-color: #D7E0EA;
    max-height: 1px;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #2563EB;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 6px 10px;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #CBD5E1;
    selection-background-color: #DBEAFE;
}

QProgressBar {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    text-align: center;
    color: #1F2937;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 3px;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #D7E0EA;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1px solid #D7E0EA;
    padding: 8px 16px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
}

QTabBar::tab:hover {
    background-color: #EAF1FB;
    color: #1F2937;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1F2937;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #CBD5E1;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    background-color: #2563EB;
    border: 2px solid #93C5FD;
    border-radius: 8px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #1D4ED8;
}

QSlider::sub-page:horizontal {
    background-color: #2563EB;
    border-radius: 2px;
}

QCheckBox {
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #CBD5E1;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #1D4ED8;
}

QLabel#alert_safe,
QLabel#arm_armed {
    color: #16A34A;
    font-weight: bold;
}

QLabel#alert_warning {
    color: #D97706;
    font-weight: bold;
}

QLabel#alert_alarm {
    color: #DC2626;
    font-weight: bold;
}

QFrame#voice_panel {
    background-color: #FFFFFF;
    border: 1px solid #EA580C;
    border-radius: 6px;
    padding: 8px;
}

QLabel#arm_disarmed {
    color: #64748B;
}

QLabel#arm_night {
    color: #7C3AED;
    font-weight: bold;
}
