/* ============================================================
   智能门禁访客管理系统 — PyQt5 样式表
   E同学：Python应用层
   v2.0 增强版：更丰富的交互反馈、缺失功能组件样式
   ============================================================ */

/* ---- 全局字体与背景 ---- */
QWidget {
    font-family: "Microsoft YaHei", "SimHei", sans-serif;
    font-size: 13px;
    color: #E8ECF3;
    background-color: #151922;
}

/* ---- 主窗口 ---- */
QMainWindow {
    background-color: #151922;
}

QScrollArea {
    background-color: #151922;
    border: none;
}

QSplitter::handle {
    background-color: #151922;
}

QSplitter::handle:horizontal {
    width: 8px;
}

/* ---- 分组框 ---- */
QGroupBox {
    border: 1px solid #2E3A4D;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    background-color: #202738;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    color: #B9C6D8;
    font-size: 14px;
    font-weight: bold;
}

/* ---- 按钮 ---- */
QPushButton {
    background-color: #2F6FDB;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #3D7FE8;
}

QPushButton:pressed {
    background-color: #255CB8;
}

QPushButton:disabled {
    background-color: #3A4250;
    color: #8792A2;
}

/* 危险按钮 */
QPushButton#btn_alarm {
    background-color: #DB3A3A;
}

QPushButton#btn_alarm:hover {
    background-color: #EB4A4A;
}

QPushButton#btn_alarm:pressed {
    background-color: #B82E2E;
}

/* 成功按钮 */
QPushButton#btn_unlock, QPushButton#btn_reset {
    background-color: #2ECC71;
}

QPushButton#btn_unlock:hover, QPushButton#btn_reset:hover {
    background-color: #3EDC81;
}

QPushButton#btn_unlock:pressed, QPushButton#btn_reset:pressed {
    background-color: #27AE60;
}

/* 门铃按钮 */
QPushButton#btn_doorbell {
    background-color: #3498DB;
}

QPushButton#btn_doorbell:hover {
    background-color: #44A8EB;
}

QPushButton#btn_doorbell:pressed {
    background-color: #2980B9;
}

/* 夜间模式按钮 */
QPushButton#btn_night {
    background-color: #8E44AD;
}

QPushButton#btn_night:hover {
    background-color: #9B59B6;
}

QPushButton#btn_night:pressed {
    background-color: #7D3C98;
}

/* 语音播报按钮 */
QPushButton#btn_voice {
    background-color: #E67E22;
}

QPushButton#btn_voice:hover {
    background-color: #F39C12;
}

QPushButton#btn_voice:pressed {
    background-color: #D35400;
}

/* ---- 标签 ---- */
QLabel {
    color: #C9D3E2;
    background: transparent;
}

QLabel#title_label {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 8px 0;
}

QLabel#status_label {
    font-size: 15px;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 4px;
}

QFrame#status_card, QFrame#env_card {
    background-color: #171F2D;
    border: 1px solid #34425A;
    border-radius: 6px;
}

QFrame#status_card:hover, QFrame#env_card:hover, QFrame#metric_card:hover {
    border-color: #3A7BDB;
}

/* ---- QLCDNumber ---- */
QLCDNumber {
    border: 1px solid #34425A;
    border-radius: 6px;
    background-color: #111722;
    color: #00E676;
    min-height: 48px;
}

/* ---- 表格 ---- */
QTableWidget {
    background-color: #202738;
    alternate-background-color: #1B2230;
    border: 1px solid #34425A;
    border-radius: 6px;
    gridline-color: #34425A;
    selection-background-color: #2F6FDB;
    selection-color: white;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #263248;
    color: #B9C6D8;
    font-weight: bold;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #2F6FDB;
}

QFrame#metric_card {
    background-color: #171F2D;
    border: 1px solid #34425A;
    border-radius: 6px;
}

QLabel#metric_title {
    color: #95A3B8;
    font-size: 11px;
}

QLabel#metric_value {
    font-size: 15px;
    font-weight: bold;
}

QPlainTextEdit#diagnostic_log {
    background-color: #111722;
    color: #DDE6F3;
    border: 1px solid #34425A;
    border-radius: 6px;
    padding: 8px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background: #151922;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #3A4658;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4A5A70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #151922;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #3A4658;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4A5A70;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #101620;
    color: #95A3B8;
    border-top: 1px solid #34425A;
}

/* ---- 分隔线 ---- */
QFrame#separator {
    background-color: #34425A;
    max-height: 1px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: #263248;
    color: #E8ECF3;
    border: 1px solid #2F6FDB;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---- 输入框 ---- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #171F2D;
    color: #E8ECF3;
    border: 1px solid #34425A;
    border-radius: 4px;
    padding: 6px 10px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2F6FDB;
}

QComboBox {
    background-color: #171F2D;
    color: #E8ECF3;
    border: 1px solid #34425A;
    border-radius: 4px;
    padding: 6px 10px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #202738;
    color: #E8ECF3;
    border: 1px solid #34425A;
    selection-background-color: #2F6FDB;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #171F2D;
    border: 1px solid #34425A;
    border-radius: 4px;
    text-align: center;
    color: #E8ECF3;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2F6FDB;
    border-radius: 3px;
}

/* ---- 选项卡 ---- */
QTabWidget::pane {
    background-color: #202738;
    border: 1px solid #34425A;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #171F2D;
    color: #95A3B8;
    border: 1px solid #34425A;
    padding: 8px 16px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #202738;
    color: #2F6FDB;
    border-bottom: 2px solid #2F6FDB;
}

QTabBar::tab:hover {
    background-color: #202738;
    color: #E8ECF3;
}

/* ---- 文本编辑器 ---- */
QTextEdit, QPlainTextEdit {
    background-color: #171F2D;
    color: #E8ECF3;
    border: 1px solid #34425A;
    border-radius: 4px;
    padding: 6px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #151922;
}

QMessageBox {
    background-color: #202738;
}

QMessageBox QLabel {
    color: #E8ECF3;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ---- 滑块 ---- */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #34425A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    background-color: #2F6FDB;
    border: 2px solid #3D7FE8;
    border-radius: 8px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #3D7FE8;
}

QSlider::sub-page:horizontal {
    background-color: #2F6FDB;
    border-radius: 2px;
}

/* ---- 复选框 ---- */
QCheckBox {
    color: #C9D3E2;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #34425A;
    border-radius: 3px;
    background-color: #171F2D;
}

QCheckBox::indicator:checked {
    background-color: #2F6FDB;
    border-color: #3D7FE8;
}

/* ============================================================
   新增：实时曲线图区域样式
   ============================================================ */
QFrame#chart_frame {
    background-color: #171F2D;
    border: 1px solid #34425A;
    border-radius: 6px;
    padding: 4px;
}

/* ============================================================
   新增：传感器扩展面板样式 (flame, gas, grating, stay, night)
   ============================================================ */
QFrame#sensor_ext_card {
    background-color: #171F2D;
    border: 1px solid #34425A;
    border-radius: 6px;
    padding: 8px;
}

QFrame#sensor_ext_card[alert="true"] {
    border-color: #DB3A3A;
    background-color: #2A1A1A;
}

/* ---- 安防面板专用 ---- */
QLabel#alert_safe {
    color: #2ECC71;
    font-weight: bold;
}

QLabel#alert_warning {
    color: #F39C12;
    font-weight: bold;
}

QLabel#alert_alarm {
    color: #DB3A3A;
    font-weight: bold;
}

/* ---- 语音播报面板 ---- */
QFrame#voice_panel {
    background-color: #171F2D;
    border: 1px solid #E67E22;
    border-radius: 6px;
    padding: 8px;
}

/* ---- 布防模式指示 ---- */
QLabel#arm_disarmed {
    color: #95A3B8;
}

QLabel#arm_armed {
    color: #2ECC71;
    font-weight: bold;
}

QLabel#arm_night {
    color: #8E44AD;
    font-weight: bold;
}
